{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.nyala.dev/connectors/v1/nyala-connector.schema.json",
	"title": "Nyala Database Connector Manifest v1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"kind",
		"id",
		"displayName",
		"description",
		"version",
		"publisher",
		"license",
		"engines",
		"connector"
	],
	"properties": {
		"$schema": {
			"type": "string",
			"format": "uri"
		},
		"schemaVersion": {
			"const": 1
		},
		"kind": {
			"const": "databaseConnector"
		},
		"id": {
			"type": "string",
			"pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
			"maxLength": 127
		},
		"displayName": {
			"type": "string",
			"minLength": 1,
			"maxLength": 80
		},
		"description": {
			"type": "string",
			"minLength": 1,
			"maxLength": 280
		},
		"version": {
			"type": "string",
			"pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
			"maxLength": 64
		},
		"publisher": {
			"$ref": "#/$defs/publisher"
		},
		"license": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"engines": {
			"$ref": "#/$defs/engines"
		},
		"connector": {
			"$ref": "#/$defs/connector"
		},
		"assets": {
			"$ref": "#/$defs/assets"
		},
		"support": {
			"$ref": "#/$defs/support"
		}
	},
	"$defs": {
		"publisher": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "displayName"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
					"maxLength": 64
				},
				"displayName": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"homepage": {
					"type": "string",
					"format": "uri",
					"pattern": "^https://"
				}
			}
		},
		"engines": {
			"type": "object",
			"additionalProperties": false,
			"required": ["nyala", "jdbcHostProtocol", "java"],
			"properties": {
				"nyala": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				},
				"jdbcHostProtocol": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				},
				"java": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64
				}
			}
		},
		"connector": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"driverId",
				"dialectId",
				"driverClass",
				"jdbcUrlTemplate",
				"artifacts",
				"connectionFields",
				"capabilities",
				"defaults"
			],
			"properties": {
				"driverId": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9-]{0,63}$"
				},
				"dialectId": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9-]{0,63}$"
				},
				"driverClass": {
					"type": "string",
					"pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)+$",
					"maxLength": 255
				},
				"jdbcUrlTemplate": {
					"type": "string",
					"pattern": "^jdbc:[^\\r\\n]+$",
					"maxLength": 512
				},
				"defaultPort": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535
				},
				"artifacts": {
					"type": "array",
					"minItems": 1,
					"maxItems": 32,
					"items": {
						"$ref": "#/$defs/artifact"
					}
				},
				"connectionFields": {
					"type": "array",
					"minItems": 1,
					"maxItems": 32,
					"items": {
						"$ref": "#/$defs/connectionField"
					}
				},
				"connectionProperties": {
					"type": "array",
					"maxItems": 64,
					"items": {
						"$ref": "#/$defs/connectionProperty"
					}
				},
				"capabilities": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"enum": [
							"connection.test",
							"query.execute",
							"query.cancel",
							"transaction",
							"metadata.catalogs",
							"metadata.schemas",
							"metadata.tables",
							"metadata.columns"
						]
					}
				},
				"defaults": {
					"$ref": "#/$defs/defaults"
				}
			}
		},
		"artifact": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "role", "delivery"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9-]{0,63}$"
				},
				"role": {
					"enum": ["driver", "dependency", "adapter"]
				},
				"delivery": {
					"enum": ["bundled", "userProvided"]
				},
				"path": {
					"type": "string",
					"pattern": "^lib/[A-Za-z0-9._+-]+\\.jar$",
					"maxLength": 255
				},
				"sha256": {
					"$ref": "#/$defs/sha256"
				},
				"sizeBytes": {
					"type": "integer",
					"minimum": 1,
					"maximum": 104857600
				},
				"acceptedArtifacts": {
					"type": "array",
					"minItems": 1,
					"maxItems": 32,
					"items": {
						"$ref": "#/$defs/userProvidedArtifact"
					}
				},
				"vendorDownloadPage": {
					"type": "string",
					"format": "uri",
					"pattern": "^https://"
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"delivery": {
								"const": "bundled"
							}
						}
					},
					"then": {
						"required": ["path", "sha256", "sizeBytes"],
						"not": {
							"anyOf": [{ "required": ["acceptedArtifacts"] }, { "required": ["vendorDownloadPage"] }]
						}
					}
				},
				{
					"if": {
						"properties": {
							"delivery": {
								"const": "userProvided"
							}
						}
					},
					"then": {
						"required": ["acceptedArtifacts", "vendorDownloadPage"],
						"not": {
							"anyOf": [{ "required": ["path"] }, { "required": ["sha256"] }, { "required": ["sizeBytes"] }]
						}
					}
				}
			]
		},
		"userProvidedArtifact": {
			"type": "object",
			"additionalProperties": false,
			"required": ["fileName", "version", "sha256", "sizeBytes"],
			"properties": {
				"fileName": {
					"type": "string",
					"pattern": "^[A-Za-z0-9._+-]+\\.jar$",
					"maxLength": 128
				},
				"version": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64
				},
				"sha256": {
					"$ref": "#/$defs/sha256"
				},
				"sizeBytes": {
					"type": "integer",
					"minimum": 1,
					"maximum": 104857600
				}
			}
		},
		"connectionField": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "label", "type", "required", "persistence"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"
				},
				"label": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"type": {
					"enum": ["string", "integer", "boolean", "enum", "secret"]
				},
				"required": {
					"type": "boolean"
				},
				"persistence": {
					"enum": ["profile", "never"]
				},
				"default": {},
				"minimum": {
					"type": "integer"
				},
				"maximum": {
					"type": "integer"
				},
				"minLength": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4096
				},
				"maxLength": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"options": {
					"type": "array",
					"minItems": 1,
					"maxItems": 64,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 128
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"type": {
								"const": "secret"
							}
						}
					},
					"then": {
						"properties": {
							"persistence": {
								"const": "never"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "enum"
							}
						}
					},
					"then": {
						"required": ["options"]
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "integer"
							}
						}
					},
					"then": {
						"properties": {
							"default": {
								"type": "integer"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "boolean"
							}
						}
					},
					"then": {
						"properties": {
							"default": {
								"type": "boolean"
							}
						}
					}
				}
			]
		},
		"connectionProperty": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "field"],
			"properties": {
				"name": {
					"type": "string",
					"pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
				},
				"field": {
					"type": "string",
					"pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"
				},
				"omitWhenEmpty": {
					"type": "boolean",
					"default": true
				}
			}
		},
		"defaults": {
			"type": "object",
			"additionalProperties": false,
			"required": ["connectTimeoutMs", "socketTimeoutMs", "fetchSize", "maxRows"],
			"properties": {
				"connectTimeoutMs": {
					"type": "integer",
					"minimum": 100,
					"maximum": 120000
				},
				"socketTimeoutMs": {
					"type": "integer",
					"minimum": 100,
					"maximum": 600000
				},
				"fetchSize": {
					"type": "integer",
					"minimum": 1,
					"maximum": 10000
				},
				"maxRows": {
					"type": "integer",
					"minimum": 1,
					"maximum": 100000
				}
			}
		},
		"assets": {
			"type": "object",
			"additionalProperties": false,
			"required": ["icon"],
			"properties": {
				"icon": {
					"type": "string",
					"pattern": "^assets/[A-Za-z0-9._+-]+\\.png$",
					"maxLength": 255
				}
			}
		},
		"support": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"homepage": {
					"type": "string",
					"format": "uri",
					"pattern": "^https://"
				},
				"issues": {
					"type": "string",
					"format": "uri",
					"pattern": "^https://"
				}
			}
		},
		"sha256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		}
	}
}
