{
	"name": "sql-studio-next",
	"version": "0.0.1-dev.1",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.33.4",
	"description": "Nyala Studio - Local-first SQL Workbench.",
	"scripts": {
		"setup": "node scripts/generate-extension-meta.js",
		"setup:full": "bash scripts/setup-extensions.sh && node scripts/generate-extension-meta.js",
		"dev": "cross-env tauri dev",
		"build": "pnpm run setup && node --max-old-space-size=12288 node_modules/vite/bin/vite.js build",
		"postbuild": "node scripts/postbuild.js",
		"preview": "vite preview",
		"dev:vite": "pnpm run setup && node --max-old-space-size=8192 node_modules/vite/bin/vite.js",
		"tauri": "cross-env tauri",
		"lint": "eslint \"src/**/*.ts\"",
		"lint:fix": "eslint --fix \"src/**/*.ts\"",
		"format": "prettier --write 'src/**/*.{ts,tsx,js,json}'",
		"format:check": "prettier --check 'src/**/*.{ts,tsx,js,json}'",
		"rust:check": "cd src-tauri && cargo check",
		"rust:clippy": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
		"rust:fmt": "cd src-tauri && cargo fmt --all -- --check",
		"rust:fmt:fix": "cd src-tauri && cargo fmt --all",
		"release:check": "node scripts/release-version.mjs check",
		"release:prepare": "node scripts/release-version.mjs prepare",
		"test:release": "node --test scripts/release-version.test.mjs && pnpm run release:check",
		"test:branding": "node scripts/verify-branding.mjs",
		"test:icons": "node scripts/verify-icons.mjs",
		"test:sql-runtime-status": "node scripts/verify-sql-runtime-status.mjs",
		"test:seed-demo": "node --test scripts/seed-demo-data-dir.test.mjs",
		"test:sql-connection-mvp": "node scripts/verify-sql-connection-mvp.mjs",
		"test:sql-metadata-explorer": "node scripts/verify-sql-metadata-explorer.mjs",
		"seed:demo": "node --no-warnings scripts/seed-demo-db.mjs",
		"benchmark:sql-result-grid": "node scripts/benchmark-sql-result-grid.mjs",
		"capture:sql-result-grid-visual": "node scripts/capture-sql-result-grid-visual.mjs",
		"capture:sql-agent-workbench": "node scripts/capture-sql-agent-workbench.mjs",
		"capture:sql-agent-workbench-native": "node scripts/capture-sql-agent-workbench-webdriver.mjs",
		"test:sql-result-grid-benchmark": "node --test scripts/benchmark-sql-result-grid.test.mjs",
		"test:sql-result-grid-webdriver": "node --test scripts/benchmark-sql-result-grid-webdriver.test.mjs",
		"test:sql-result-grid-visual": "node --test scripts/capture-sql-result-grid-visual.test.mjs",
		"test:sql-agent-workbench-visual": "node --test scripts/serve-frontend-dist.test.mjs scripts/capture-sql-agent-workbench.test.mjs scripts/capture-sql-agent-workbench-webdriver.test.mjs",
		"test:sql-result-grid-platform-evidence": "node --test scripts/merge-sql-result-grid-platform-evidence.test.mjs",
		"verify:sql-result-grid-gate": "node scripts/verify-sql-result-grid-gate.mjs",
		"test:sql-result-grid-gate": "node --test scripts/verify-sql-result-grid-gate.test.mjs",
		"verify:sql-mvp-vnext-release": "node scripts/verify-sql-mvp-vnext-release.mjs",
		"test:sql-mvp-vnext-release": "node --test scripts/verify-sql-mvp-vnext-release.test.mjs",
		"test:rust": "cd src-tauri && cargo test --lib",
		"test:sql-agent": "cd src-tauri && cargo test -p sql-studio-next --lib commands::sql::agent && cd .. && node --test --import tsx src/vs/workbench/contrib/sqlAdvanced/test/sqlCapabilities.test.ts",
		"test:search": "node --test --import tsx src/vs/workbench/services/search/test/tauriSearchCancellation.test.ts",
		"test:preferences": "node --test --import tsx src/vs/workbench/contrib/preferences/test/settingsSearchRegression.test.ts",
		"test:sql-services": "node --test --import tsx src/vs/workbench/services/sql/test/sqlServices.test.ts src/vs/workbench/services/sql/test/sqlConnectionProfile.test.ts src/vs/workbench/services/sql/test/sqlConnectionProfileV2.test.ts src/vs/workbench/services/sql/test/sqlConnectionServiceV2.test.ts src/vs/workbench/services/sql/test/sqlAiService.test.ts src/vs/workbench/services/sql/test/sqlAgentService.test.ts src/vs/workbench/services/sql/test/sqlAgentArtifacts.test.ts src/vs/workbench/services/sql/test/sqlDriverCatalog.test.ts src/vs/workbench/services/sql/test/sqlDriverPackages.test.ts src/vs/workbench/services/sql/test/sqlConnectorRuntimeGuard.test.ts src/vs/workbench/services/sql/test/sqlConnectionEditorInput.test.ts",
		"test:sql-domain": "node --test --import tsx src/vs/workbench/services/sql/test/sqlDialect.test.ts src/vs/workbench/services/sql/test/sqlDrivers.test.ts",
		"test:sql-connections": "node --test --import tsx src/vs/workbench/contrib/sqlConnections/test/sqlConnectionTreeModel.test.ts src/vs/workbench/contrib/sqlConnections/test/sqlConnectionTreeModelV2.test.ts src/vs/workbench/contrib/sqlConnections/test/sqlConnectionQueryModel.test.ts src/vs/workbench/contrib/sqlConnections/test/sqlConnectionTemplateModel.test.ts src/vs/workbench/contrib/sqlConnections/test/sqlConnectionForm.test.ts src/vs/workbench/contrib/sqlConnections/test/sqlConnectionFormModel.test.ts src/vs/workbench/contrib/sqlConnections/test/sqlConnectionFormOperation.test.ts src/vs/workbench/contrib/sqlConnections/test/sqlConnectionFormAccessibility.test.ts src/vs/workbench/contrib/sqlConnections/test/sqlConnectorPresentationModel.test.ts src/vs/workbench/contrib/sqlConnections/test/sqlDataSourceManagementModel.test.ts src/vs/workbench/contrib/sqlConnections/test/sqlDataSourceContextMenu.test.ts src/vs/workbench/contrib/sqlConnections/test/sqlConnectionSqlActions.test.ts src/vs/workbench/contrib/sqlConnections/test/sqlConnectionNavigation.test.ts src/vs/workbench/contrib/sqlConnections/test/sqlConnectionDialogService.test.ts src/vs/workbench/contrib/sqlConnections/test/driverCardBadge.test.ts src/vs/workbench/contrib/sqlConnections/test/sqlExplorerView.test.ts src/vs/workbench/contrib/sqlConnections/test/sqlMysqlValidationView.test.ts src/vs/workbench/contrib/sqlConnections/test/sqlConnectionRefresh.test.ts",
		"test:sql-editor": "node --test --import tsx src/vs/workbench/contrib/sqlEditor/test/sqlEditor.test.ts src/vs/workbench/contrib/sqlEditor/test/sqlEditorModel.test.ts src/vs/workbench/contrib/sqlEditor/test/sqlEditorDraftService.test.ts src/vs/workbench/contrib/sqlEditor/test/sqlEditorExecutionController.test.ts",
		"test:mysql-integration": "cd src-tauri && cargo test --lib mysql_preview_validation_live_contract -- --ignored",
		"test:sql-result": "node --test --import tsx src/vs/workbench/contrib/sqlResult/test/sqlResultModel.test.ts src/vs/workbench/contrib/sqlResult/test/sqlResultGridModel.test.ts src/vs/workbench/contrib/sqlResult/test/sqlResultRenderer.test.ts",
		"test:sql-history": "node --test --import tsx src/vs/workbench/contrib/sqlHistory/test/sqlQueryHistoryModel.test.ts src/vs/workbench/contrib/sqlHistory/test/sqlQueryHistoryService.test.ts src/vs/workbench/contrib/sqlHistory/test/sqlQueryHistoryViewModel.test.ts src/vs/workbench/contrib/sqlHistory/test/sqlQueryHistoryViewLifecycle.test.ts",
		"test:sql-product": "node --test --import tsx src/vs/workbench/contrib/sqlProduct/test/sqlProductProfile.test.ts src/vs/workbench/contrib/sqlProduct/test/sqlProductBootstrapModel.test.ts src/vs/workbench/contrib/sqlProduct/test/sqlProductPreferences.test.ts src/vs/workbench/contrib/sqlProduct/test/sqlProductPreferencesService.test.ts src/vs/workbench/contrib/sqlProduct/test/sqlProductIntegrationModel.test.ts src/vs/workbench/contrib/sqlProduct/test/sqlProductWelcomeView.test.ts src/vs/workbench/contrib/sqlProduct/test/sqlProductWelcomePane.test.ts src/vs/workbench/contrib/sqlProduct/test/sqlWorkbenchSplash.test.ts src/vs/workbench/browser/test/windowZoomLevel.test.ts",
		"test:sql-advanced": "node --test --import tsx src/vs/workbench/contrib/sqlAdvanced/test/sqlAdvancedFormatter.test.ts src/vs/workbench/contrib/sqlAdvanced/test/sqlAdvancedExplain.test.ts src/vs/workbench/contrib/sqlAdvanced/test/sqlAdvancedSnippets.test.ts src/vs/workbench/contrib/sqlAdvanced/test/sqlAdvancedWorkspace.test.ts src/vs/workbench/contrib/sqlAdvanced/test/sqlAdvancedPluginApi.test.ts src/vs/workbench/contrib/sqlAdvanced/test/sqlAdvancedAi.test.ts src/vs/workbench/contrib/sqlAdvanced/test/sqlAdvancedCommands.test.ts src/vs/workbench/contrib/sqlAdvanced/test/sqlAiContextBuilder.test.ts src/vs/workbench/contrib/sqlAdvanced/test/sqlAgentSchemaLoader.test.ts src/vs/workbench/contrib/sqlAdvanced/test/sqlAgentFixContext.test.ts src/vs/workbench/contrib/sqlAdvanced/test/sqlPluginContributionBridge.test.ts src/vs/workbench/contrib/sqlAdvanced/test/sqlCapabilities.test.ts src/vs/workbench/contrib/sqlAgent/test/sqlAgentPanelModel.test.ts",
		"test": "pnpm run test:release && pnpm run test:branding && pnpm run test:icons && pnpm run test:sql-runtime-status && pnpm run test:seed-demo && pnpm run test:rust && pnpm run test:sql-agent && pnpm run test:sql-result-grid-benchmark && pnpm run test:sql-result-grid-webdriver && pnpm run test:sql-result-grid-platform-evidence && pnpm run test:sql-result-grid-visual && pnpm run test:sql-agent-workbench-visual && pnpm run test:search && pnpm run test:preferences && pnpm run test:sql-services && pnpm run test:sql-domain && pnpm run test:sql-connections && pnpm run test:sql-editor && pnpm run test:sql-result && pnpm run test:sql-history && pnpm run test:sql-product && pnpm run test:sql-advanced"
	},
	"dependencies": {
		"@microsoft/1ds-core-js": "^4.4.3",
		"@microsoft/1ds-post-js": "^4.4.3",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-shell": "^2",
		"@vscode/codicons": "^0.0.45",
		"@vscode/iconv-lite-umd": "^0.7.1",
		"@vscode/tree-sitter-wasm": "^0.3.1",
		"@xterm/addon-canvas": "^0.7.0",
		"@xterm/addon-clipboard": "^0.2.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-image": "^0.9.0",
		"@xterm/addon-ligatures": "^0.10.0",
		"@xterm/addon-progress": "^0.2.0",
		"@xterm/addon-search": "^0.16.0",
		"@xterm/addon-serialize": "^0.14.0",
		"@xterm/addon-unicode11": "^0.9.0",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/xterm": "^6.0.0",
		"monaco-editor": "^0.55.1",
		"tas-client": "^0.4.1",
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.3.2"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.11.4",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@types/katex": "^0.16.8",
		"@types/trusted-types": "^2.0.7",
		"@typescript-eslint/eslint-plugin": "^8.62.1",
		"@typescript-eslint/parser": "^8.62.1",
		"@webgpu/types": "^0.1.71",
		"@xterm/headless": "^6.0.0",
		"cross-env": "^10.1.0",
		"eslint": "^10.6.0",
		"jschardet": "^3.1.4",
		"prettier": "^3.9.4",
		"tsx": "^4.23.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.62.1",
		"vite": "^8.1.3",
		"vite-plugin-static-copy": "^4.1.1"
	},
	"pnpm": {
		"overrides": {
			"minimatch>brace-expansion": "5.0.9",
			"monaco-editor>dompurify": "3.4.13",
			"postcss>nanoid": "3.3.17",
			"vite>postcss": "8.5.23"
		}
	}
}
